uniform float3 iResolution;
uniform float iTime;
uniform float uCharge;
uniform float uSnap;
uniform float2 uTip;

half4 main(float2 coord) {
    float2 p = coord - uTip;
    float d = length(p);
    float a = atan(p.y, p.x);
    float bolt = 0.0;
    for (int i = 0; i < 5; ++i) {
        float k = float(i);
        float arc = iTime * (8.4 - k * 1.28) + k * 1.71;
        float angle = abs(atan(sin(a - arc), cos(a - arc)));
        float warp = sin(d * (0.041 + k * 0.006) + k * 1.73 + iTime * 23.0) * 0.14
                   + sin(d * 0.115 - iTime * 17.0 + k) * 0.07;
        float bright = (0.55 + 0.45 * sin(iTime * 45.0 + k * 8.1));
        float line = exp(-abs(angle - 0.12 - warp) * (15.0 + d * 0.11));
        float cutoff = smoothstep(10.0, 23.0, d) * (1.0 - smoothstep(44.0 + k * 5.0, 106.0 + uCharge * 90.0, d));
        bolt += line * cutoff * bright;
    }
    float compression = exp(-abs(d - (60.0 - 38.0 * uCharge)) * 0.43);
    float glow = exp(-d * 0.030);
    float spark = max(0.0, cos(a * 8.0 + 0.55));
    float bloom = glow * uCharge * (0.43 + 0.22 * cos(iTime * 51.0));
    float alpha = min(1.0, (bolt * 0.46 + compression * 0.14) * uCharge
        + bloom + uSnap * (glow * 0.65 + exp(-d * 0.012) * pow(spark, 58.0) * 0.6));
    half3 color = mix(half3(0.99, 0.43, 0.10), half3(1.0, 0.95, 0.71), half(clamp(bolt + glow, 0.0, 1.0)));
    return half4(color * half(alpha), half(alpha));
}
