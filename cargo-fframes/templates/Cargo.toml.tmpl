[package]
name = "{{crate_name}}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
{{fframes_dep}}
{{skia_dep}}{{codecs}}
[target.'cfg(all({{dylib_target}}))'.dependencies]
fframes-dylib = { {{dylib_dep}}, optional = true }

[features]
default = ["dynamic-linking"]
dynamic-linking = ["dep:fframes-dylib"]

[lib]
name = "{{lib_name}}"
path = "src/lib.rs"
doctest = false

[[bin]]
name = "{{crate_name}}"
path = "src/main.rs"
{{standalone_tables}}
