  ],
  "versionGroups": [
    {
      "label": "Enforce devDependencies",
      "dependencies": ["wasm-pack", "vite"],
      "dependencyTypes": ["!dev"],
      "isBanned": true
    },
    {
      "label": "Use workspace protocol when developing local packages",
      "packages": ["!fframes-editor"],
      "dependencies": ["@fframes/editor"],
      "pinVersion": "*"
    }
  ]
}
