{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(lldb) Debug raw C libav code",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/fframes-renderer/c_render_bin",
      "preLaunchTask": "cexample:build",
      "args": ["out.webm"],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Hello World",
      "program": "${workspaceFolder}/target/debug/hello_world_example_bin",
      "args": ["1", "2"],
      "cwd": "${workspaceFolder}/examples/hello-world",
      "preLaunchTask": "cargo:build"
    }
  ]
}
